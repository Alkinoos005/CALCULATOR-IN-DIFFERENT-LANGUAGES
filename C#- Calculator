using System;
using System.Threading;

class Program
{
    // Animation For Mistakes / Error (Cookie)
    static void ShowCookieError()
    {
        Console.WriteLine("\n  [ ERROR! OOPS... ]");
        for (int i = 0; i < 2; i++)
        {
            Console.WriteLine("     .-'''''-.  ");
            Console.WriteLine("    /  o   O  \\ ");
            Console.WriteLine("   |  o   o  o |  <-- (Crispy Error Cookie!)");
            Console.WriteLine("    \\   O    /  ");
            Console.WriteLine("     '-.....-'  ");
            Thread.Sleep(300); // 0.3 seconds delay for animation effect
        }
    }

    // Success Animation Effect (Cupcake)
    static void ShowCupcakeSuccess()
    {
        Console.WriteLine("\n  [ WELL DONE! EXCELLENT WORK! ]");
        Console.WriteLine("       (  )  (  )  ");
        Console.WriteLine("      (  *  *  )  ");
        Console.WriteLine("     ===========");
        Console.WriteLine("     \\         /  <-- (Sweet Success Cupcake!)");
        Console.WriteLine("      \\_______/ \n");
    }

    static void Main()
    {
        double a, b, powerExp;

        Console.Write("Enter first number (a): ");
        if (!double.TryParse(Console.ReadLine(), out a))
        {
            ShowCookieError();
            return;
        }

        Console.Write("Enter second number (b): ");
        if (!double.TryParse(Console.ReadLine(), out b))
        {
            ShowCookieError();
            return;
        }

        Console.WriteLine("\n Basic Operations ");
        Console.WriteLine($"Addition: a + b = {a + b}");
        Console.WriteLine($"Subtraction: a - b = {a - b}");
        Console.WriteLine($"Multiplication: a * b = {a * b}");

        // Check for division by zero
        if (b != 0)
        {
            Console.WriteLine($"Division: a / b = {a / b}");
            ShowCupcakeSuccess();
        }
        else
        {
            Console.WriteLine("Division: Cannot divide by zero!");
            ShowCookieError();
        }

        Console.WriteLine(" Powers ");
        // (^2) & (^3)
        Console.WriteLine($"a squared (a^2): {Math.Pow(a, 2)}");
        Console.WriteLine($"a cubed (a^3): {Math.Pow(a, 3)}");
        Console.WriteLine($"b squared (b^2): {Math.Pow(b, 2)}");
        Console.WriteLine($"b cubed (b^3): {Math.Pow(b, 3)}");

        // The user picks the power he/she wants to use (a^b)
        Console.WriteLine($"a raised to power b (a^b): {Math.Pow(a, b)}");

        Console.Write("\n Enter a custom exponent power to raise 'a': ");
        if (double.TryParse(Console.ReadLine(), out powerExp))
        {
            Console.WriteLine($"a^{powerExp} = {Math.Pow(a, powerExp)}");
            ShowCupcakeSuccess();
        }
        else
        {
            Console.WriteLine("Invalid exponent entered!");
            ShowCookieError();
            return;
        }

        Console.WriteLine(" Square Root ");
        if (a >= 0)
        {
            Console.WriteLine($"Square root of a (√a): {Math.Sqrt(a)}");
            ShowCupcakeSuccess();
        }
        else
        {
            Console.WriteLine("Square root of a: Cannot calculate sqrt of negative number!");
            ShowCookieError();
        }

        if (b >= 0)
        {
            Console.WriteLine($"Square root of b (√b): {Math.Sqrt(b)}");
            ShowCupcakeSuccess();
        }
        else
        {
            Console.WriteLine("Square root of b: Cannot calculate sqrt of negative number!");
            ShowCookieError();
        }
    }
}
