#include <iostream>
#include <cmath>
#include <thread>
#include <chrono>

// Animation For Mistakes / Error (Cookie)
void show_cookie_error() {
    std::cout << "\n  [ ERROR! OOPS... ]\n";
    for (int i = 0; i < 2; i++) {
        std::cout << "     .-'''''-.  \n";
        std::cout << "    /  o   O  \\ \n";
        std::cout << "   |  o   o  o |  <-- (Crispy Error Cookie!)\n";
        std::cout << "    \\   O    /  \n";
        std::cout << "     '-.....-'  \n";
        std::this_thread::sleep_for(std::chrono::milliseconds(300)); // Delay 0.3 sec
    }
}

// Success Animation Effect (Cupcake)
void show_cupcake_success() {
    std::cout << "\n  [ WELL DONE! EXCELLENT WORK! ]\n";
    std::cout << "       (  )  (  )  \n";
    std::cout << "      (  *  *  )  \n";
    std::cout << "     ===========\n";
    std::cout << "     \\         /  <-- (Sweet Success Cupcake!)\n";
    std::cout << "      \\_______/ \n\n";
}

int main() {
    double a, b, power_exp;

    std::cout << "Enter first number (a): ";
    if (!(std::cin >> a)) {
        show_cookie_error();
        return 1;
    }

    std::cout << "Enter second number (b): ";
    if (!(std::cin >> b)) {
        show_cookie_error();
        return 1;
    }

    std::cout << "\n Basic Operations \n";
    std::cout << "Addition: a + b = " << a + b << "\n";
    std::cout << "Subtraction: a - b = " << a - b << "\n";
    std::cout << "Multiplication: a * b = " << a * b << "\n";

    // Check for division by zero
    if (b != 0) {
        std::cout << "Division: a / b = " << a / b << "\n";
        show_cupcake_success();
    } else {
        std::cout << "Division: Cannot divide by zero!\n";
        show_cookie_error();
    }

    std::cout << " Powers \n";
    // (^2) & (^3)
    std::cout << "a squared (a^2): " << std::pow(a, 2) << "\n";
    std::cout << "a cubed (a^3): " << std::pow(a, 3) << "\n";
    std::cout << "b squared (b^2): " << std::pow(b, 2) << "\n";
    std::cout << "b cubed (b^3): " << std::pow(b, 3) << "\n";

    // The user picks the power he/she wants to use (a^b)
    std::cout << "a raised to power b (a^b): " << std::pow(a, b) << "\n";

    std::cout << "\n Enter a custom exponent power to raise 'a': ";
    if (std::cin >> power_exp) {
        std::cout << "a^" << power_exp << " = " << std::pow(a, power_exp) << "\n";
        show_cupcake_success();
    } else {
        std::cout << "Invalid exponent entered!\n";
        show_cookie_error();
        return 1;
    }

    std::cout << " Square Root \n";
    if (a >= 0) {
        std::cout << "Square root of a (√a): " << std::sqrt(a) << "\n";
        show_cupcake_success();
    } else {
        std::cout << "Square root of a: Cannot calculate sqrt of negative number!\n";
        show_cookie_error();
    }

    if (b >= 0) {
        std::cout << "Square root of b (√b): " << std::sqrt(b) << "\n";
        show_cupcake_success();
    } else {
        std::cout << "Square root of b: Cannot calculate sqrt of negative number!\n";
        show_cookie_error();
    }

    return 0;
}
