#include <stdio.h>

int main() {
    double a, b;
    printf("Enter first number: ");
    scanf("%lf", &a);
    printf("Enter second number: ");
    scanf("%lf", &b);
    printf("Addition: %lf\n", a + b);
    printf("Subtraction: %lf\n", a - b);
    printf("Multiplication: %lf\n", a * b);
    printf("Division: %lf\n", a / b);
    return 0;
}
