#include <stdio.h>
#include <math.h>
#include <unistd.h> // Για τη συνάρτηση usleep (animation delay)

// Animation For Mistakes/ Error(Cookie)
void show_cookie_error() {
    printf("\n  [ ERROR! OOPS... ]\n");
    for (int i = 0; i < 2; i++) {
        printf("     .-'''''-.  \n");
        printf("    /  o   O  \\ \n");
        printf("   |  o   o  o |  <-- (Crispy Error Cookie!)\n");
        printf("    \\   O    /  \n");
        printf("     '-.....-'  \n");
        usleep(300000); // Slower by  0.3 secs for the animation effect
    }
}

// Success Animation Effect (Cupcake)
void show_cupcake_success() {
    printf("\n  [ WELL DONE! EXCELLENT WORK! ]\n");
    printf("       (  )  (  )  \n");
    printf("      (  *  *  )  \n");
    printf("     ===========\n");
    printf("     \\         /  <-- (Sweet Success Cupcake!)\n");
    printf("      \\_______/ \n\n");
}

int main() {
    double a, b, power_exp;

    printf("Enter first number (a): ");
    if (scanf("%lf", &a) != 1) {
        show_cookie_error();
        return 1;
    }

    printf("Enter second number (b): ");
    if (scanf("%lf", &b) != 1) {
        show_cookie_error();
        return 1;
    }

    printf("\n--- Basic Operations ---\n");
    printf("Addition: a + b = %lf\n", a + b);
    printf("Subtraction: a - b = %lf\n", a - b);
    printf("Multiplication: a * b = %lf\n", a * b);

    // Έλεγχος διαίρεσης με το μηδέν
    if (b != 0) {
        printf("Division: a / b = %lf\n", a / b);
        show_cupcake_success();
    } else {
        printf("Division: Cannot divide by zero!\n");
        show_cookie_error();
    }

    printf("--- Powers (Δυνάμεις) ---\n");
    // Τετράγωνο (^2) και Κύβος (^3)
    printf("a squared (a^2): %lf\n", pow(a, 2));
    printf("a cubed (a^3): %lf\n", pow(a, 3));
    printf("b squared (b^2): %lf\n", pow(b, 2));
    printf("b cubed (b^3): %lf\n", pow(b, 3));

    // Δύναμη επιλογής του χρήστη (a^b)
    printf("a raised to power b (a^b): %lf\n", pow(a, b));
    
    printf("\nEnter a custom exponent power to raise 'a': ");
    if (scanf("%lf", &power_exp) == 1) {
        printf("a^%lf = %lf\n", power_exp, pow(a, power_exp));
        show_cupcake_success();
    } else {
        printf("Invalid exponent entered!\n");
        show_cookie_error();
    }

    printf("--- Square Root (Ρίζα) ---\n");
    if (a >= 0) {
        printf("Square root of a (√a): %lf\n", sqrt(a));
        show_cupcake_success();
    } else {
        printf("Square root of a: Cannot calculate sqrt of negative number!\n");
        show_cookie_error();
    }

    if (b >= 0) {
        printf("Square root of b (√b): %lf\n", sqrt(b));
        show_cupcake_success();
    } else {
        printf("Square root of b: Cannot calculate sqrt of negative number!\n");
        show_cookie_error();
    }

    return 0;
}
