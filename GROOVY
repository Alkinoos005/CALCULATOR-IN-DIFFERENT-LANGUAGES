import java.lang.Thread

// Animation For Mistakes / Error (Cookie)
void showCookieError() {
    println("\n  [ ERROR! OOPS... ]")
    2.times {
        println("     .-'''''-.  ")
        println("    /  o   O  \\ ")
        println("   |  o   o  o |  <-- (Crispy Error Cookie!)")
        println("    \\   O    /  ")
        println("     '-.....-'  ")
        Thread.sleep(300) // 0.3 seconds delay for animation effect
    }
}

// Success Animation Effect (Cupcake)
void showCupcakeSuccess() {
    println("\n  [ WELL DONE! EXCELLENT WORK! ]")
    println("       (  )  (  )  ")
    println("      (  *  *  )  ")
    println("     ===========")
    println("     \\         /  <-- (Sweet Success Cupcake!)")
    println("      \\_______/ \n")
}

// Helper function to safely parse Double input
Double getDoubleInput(String prompt) {
    print(prompt)
    String input = System.console() ? System.console().readLine() : new Scanner(System.in).nextLine()
    try {
        return Double.parseDouble(input)
    } catch (NumberFormatException e) {
        showCookieError()
        return null
    }
}

Double a = getDoubleInput("Enter first number (a): ")
if (a == null) System.exit(1)

Double b = getDoubleInput("Enter second number (b): ")
if (b == null) System.exit(1)

println("\n Basic Operations ")
println("Addition: a + b = ${a + b}")
println("Subtraction: a - b = ${a - b}")
println("Multiplication: a * b = ${a * b}")

// Check for division by zero
if (b != 0) {
    println("Division: a / b = ${a / b}")
    showCupcakeSuccess()
} else {
    println("Division: Cannot divide by zero!")
    showCookieError()
}

println(" Powers ")
// (^2) & (^3)
println("a squared (a^2): ${Math.pow(a, 2)}")
println("a cubed (a^3): ${Math.pow(a, 3)}")
println("b squared (b^2): ${Math.pow(b, 2)}")
println("b cubed (b^3): ${Math.pow(b, 3)}")

// The user picks the power he/she wants to use (a^b)
println("a raised to power b (a^b): ${Math.pow(a, b)}")

Double powerExp = getDoubleInput("\n Enter a custom exponent power to raise 'a': ")
if (powerExp != null) {
    println("a^${powerExp} = ${Math.pow(a, powerExp)}")
    showCupcakeSuccess()
} else {
    println("Invalid exponent entered!")
    System.exit(1)
}

println(" Square Root ")
if (a >= 0) {
    println("Square root of a (√a): ${Math.sqrt(a)}")
    showCupcakeSuccess()
} else {
    println("Square root of a: Cannot calculate sqrt of negative number!")
    showCookieError()
}

if (b >= 0) {
    println("Square root of b (√b): ${Math.sqrt(b)}")
    showCupcakeSuccess()
} else {
    println("Square root of b: Cannot calculate sqrt of negative number!")
    showCookieError()
}
