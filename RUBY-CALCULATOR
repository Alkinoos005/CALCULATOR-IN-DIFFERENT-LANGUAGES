# Animation For Mistakes / Error (Cookie)
def show_cookie_error
  puts "\n  [ ERROR! OOPS... ]"
  2.times do
    puts "     .-'''''-.  "
    puts "    /  o   O  \\ "
    puts "   |  o   o  o |  <-- (Crispy Error Cookie!)"
    puts "    \\   O    /  "
    puts "     '-.....-'  "
    sleep(0.3) # 0.3 seconds delay for animation effect
  end
end

# Success Animation Effect (Cupcake)
def show_cupcake_success
  puts "\n  [ WELL DONE! EXCELLENT WORK! ]"
  puts "       (  )  (  )  "
  puts "      (  *  *  )  "
  puts "     ==========="
  puts "     \\         /  <-- (Sweet Success Cupcake!)"
  puts "      \\_______/ \n\n"
end

# Helper function to get valid float input
def get_float_input(prompt)
  print prompt
  input = gets.strip
  
  # Check if input is a valid numeric string
  if input.empty? || !Float(input, exception: false)
    show_cookie_error
    return nil
  end
  
  input.to_f
end

a = get_float_input("Enter first number (a): ")
exit if a.nil?

b = get_float_input("Enter second number (b): ")
exit if b.nil?

puts "\n Basic Operations "
puts "Addition: a + b = #{a + b}"
puts "Subtraction: a - b = #{a - b}"
puts "Multiplication: a * b = #{a * b}"

# Check for division by zero
if b != 0
  puts "Division: a / b = #{a / b}"
  show_cupcake_success
else
  puts "Division: Cannot divide by zero!"
  show_cookie_error
end

puts " Powers "
# (^2) & (^3)
puts "a squared (a^2): #{a**2}"
puts "a cubed (a^3): #{a**3}"
puts "b squared (b^2): #{b**2}"
puts "b cubed (b^3): #{b**3}"

# The user picks the power he/she wants to use (a^b)
puts "a raised to power b (a^b): #{a**b}"

power_exp = get_float_input("\n Enter a custom exponent power to raise 'a': ")
if power_exp
  puts "a^#{power_exp} = #{a**power_exp}"
  show_cupcake_success
else
  puts "Invalid exponent entered!"
  exit
end

puts " Square Root "
if a >= 0
  puts "Square root of a (√a): #{Math.sqrt(a)}"
  show_cupcake_success
else
  puts "Square root of a: Cannot calculate sqrt of negative number!"
  show_cookie_error
end

if b >= 0
  puts "Square root of b (√b): #{Math.sqrt(b)}"
  show_cupcake_success
else
  puts "Square root of b: Cannot calculate sqrt of negative number!"
  show_cookie_error
end
